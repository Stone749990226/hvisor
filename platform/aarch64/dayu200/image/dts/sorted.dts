/dts-v1/;

/ {
	compatible = "rockchip,rk3568-toybrick-dev-linux-x0\0rockchip,rk3568";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	serial-number = "JZ58FC25080043";

	otp@fe38c000 {
		resets = <0x24 0x1cf>;
		compatible = "rockchip,rk3568-otp";
		#size-cells = <0x01>;
		clock-names = "usr\0sbpi\0apb\0phy";
		clocks = <0x24 0x73 0x24 0x72 0x24 0x71 0x24 0x181>;
		reg = <0x00 0xfe38c000 0x00 0x4000>;
		#address-cells = <0x01>;
		reset-names = "otp_phy";

		cpu-leakage@1a {
			phandle = <0x06>;
			reg = <0x1a 0x01>;
		};

		specification-serial-number@7 {
			phandle = <0x0a>;
			bits = <0x00 0x05>;
			reg = <0x07 0x01>;
		};

		cpu-tsadc-trim-l@2e {
			phandle = <0x123>;
			reg = <0x2e 0x01>;
		};

		remark-spec-serial-number@56 {
			phandle = <0x0b>;
			bits = <0x00 0x05>;
			reg = <0x56 0x01>;
		};

		npu-opp-info@42 {
			phandle = <0x6d>;
			reg = <0x42 0x06>;
		};

		npu-leakage@1c {
			phandle = <0x6c>;
			reg = <0x1c 0x01>;
		};

		gpu-leakage@1d {
			phandle = <0x1a>;
			reg = <0x1d 0x01>;
		};

		log-leakage@1b {
			phandle = <0x7d>;
			reg = <0x1b 0x01>;
		};

		dmc-opp-info@48 {
			phandle = <0xc1>;
			reg = <0x48 0x06>;
		};

		id@a {
			phandle = <0x0c>;
			reg = <0x0a 0x10>;
		};

		tsadc-trim-base@32 {
			phandle = <0x11f>;
			reg = <0x32 0x01>;
		};

		tsadc-trim-base-frac@31 {
			phandle = <0x120>;
			bits = <0x04 0x04>;
			reg = <0x31 0x01>;
		};

		npu-tsadc-trim-l@30 {
			phandle = <0x125>;
			reg = <0x30 0x01>;
		};

		cpu-code@2 {
			phandle = <0x0e>;
			reg = <0x02 0x02>;
		};

		gpu-opp-info@3c {
			phandle = <0x1b>;
			reg = <0x3c 0x06>;
		};

		cpu-version@8 {
			phandle = <0x0d>;
			bits = <0x03 0x03>;
			reg = <0x08 0x01>;
		};

		cpu-opp-info@36 {
			phandle = <0x09>;
			reg = <0x36 0x06>;
		};

		core-pvtm@2a {
			phandle = <0x07>;
			reg = <0x2a 0x02>;
		};

		mbist-vmin@9 {
			phandle = <0x08>;
			bits = <0x00 0x04>;
			reg = <0x09 0x01>;
		};

		cpu-tsadc-trim-h@2f {
			phandle = <0x124>;
			bits = <0x00 0x04>;
			reg = <0x2f 0x01>;
		};

		npu-tsadc-trim-h@31 {
			phandle = <0x126>;
			bits = <0x00 0x04>;
			reg = <0x31 0x01>;
		};
	};

	rkcif_mipi_lvds {
		compatible = "rockchip,rkcif-mipi-lvds";
		phandle = <0x81>;
		rockchip,hw = <0x7f>;
		status = "disabled";
	};

	external-gmac1-clock {
		clock-output-names = "gmac1_clkin";
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		#clock-cells = <0x00>;
	};

	external-gmac0-clock {
		clock-output-names = "gmac0_clkin";
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		#clock-cells = <0x00>;
	};

	bus-npu {
		compatible = "rockchip,rk3568-bus";
		pvtm-supply = <0x05>;
		clock-names = "bus";
		clocks = <0x02 0x02>;
		bus-supply = <0x6f>;
		rockchip,busfreq-policy = "clkfreq";
		status = "okay";
		operating-points-v2 = <0x6e>;
	};

	serial@fe6d0000 {
		reg-shift = <0x02>;
		compatible = "rockchip,rk3568-uart\0snps,dw-apb-uart";
		clock-names = "baudclk\0apb_pclk";
		pinctrl-0 = <0x10f>;
		clocks = <0x24 0x13f 0x24 0x13c>;
		interrupts = <0x00 0x7d 0x04>;
		reg = <0x00 0xfe6d0000 0x00 0x100>;
		pinctrl-names = "default";
		reg-io-width = <0x04>;
		status = "disabled";
		dmas = <0x48 0x12 0x48 0x13>;
	};

	nocp-vo@fe103000 {
		compatible = "rockchip,rk3568-nocp";
		reg = <0x00 0xfe103000 0x00 0x400>;
	};

	qos@fe148080 {
		compatible = "rockchip,rk3568-qos\0syscon";
		phandle = <0x51>;
		reg = <0x00 0xfe148080 0x00 0x20>;
	};

	usb2-phy@fe8a0000 {
		clock-output-names = "usb480m_phy";
		compatible = "rockchip,rk3568-usb2phy";
		clock-names = "phyclk";
		clocks = <0x3a 0x13>;
		interrupts = <0x00 0x87 0x04>;
		phandle = <0x2a>;
		assigned-clocks = <0x24 0x0b>;
		assigned-clock-parents = <0x2a>;
		reg = <0x00 0xfe8a0000 0x00 0x10000>;
		rockchip,usbgrf = <0x130>;
		#clock-cells = <0x00>;
		status = "okay";

		otg-port {
			vbus-supply = <0x132>;
			#phy-cells = <0x00>;
			phandle = <0x28>;
			status = "okay";
		};

		host-port {
			#phy-cells = <0x00>;
			phandle = <0x2b>;
			phy-supply = <0x131>;
			status = "okay";
		};
	};

	phy@fe8c0000 {
		resets = <0x24 0x1be>;
		compatible = "rockchip,rk3568-pcie3-phy";
		rockchip,phy-grf = <0x14f>;
		#phy-cells = <0x00>;
		clock-names = "refclk_m\0refclk_n\0pclk";
		clocks = <0x3a 0x26 0x3a 0x27 0x24 0x177>;
		phandle = <0x141>;
		reg = <0x00 0xfe8c0000 0x00 0x20000>;
		status = "okay";
		rockchip,pipe-grf = <0x128>;
		reset-names = "phy";
	};

	watchdog@fe600000 {
		compatible = "rockchip,rk3568-wdt\0snps,dw-wdt";
		clock-names = "tclk\0pclk";
		clocks = <0x24 0x116 0x24 0x115>;
		interrupts = <0x00 0x95 0x04>;
		reg = <0x00 0xfe600000 0x00 0x100>;
	};

	phy@fe840000 {
		resets = <0x24 0x1c8 0x24 0x1c9>;
		compatible = "rockchip,rk3568-naneng-combphy";
		#phy-cells = <0x01>;
		clock-names = "refclk\0apbclk\0pipe_clk";
		clocks = <0x3a 0x25 0x24 0x17e 0x24 0x7f>;
		phandle = <0x27>;
		assigned-clocks = <0x3a 0x25>;
		assigned-clock-rates = <0x5f5e100>;
		reg = <0x00 0xfe840000 0x00 0x100>;
		rockchip,pipe-phy-grf = <0x12a>;
		status = "okay";
		rockchip,pipe-grf = <0x128>;
		reset-names = "combphy-apb\0combphy";
	};

	backlight {
		brightness-levels = <0x00 0x14 0x14 0x15 0x15 0x16 0x16 0x17 0x17 0x18 0x18 0x19 0x19 0x1a 0x1a 0x1b 0x1b 0x1c 0x1c 0x1d 0x1d 0x1e 0x1e 0x1f 0x1f 0x20 0x20 0x21 0x21 0x22 0x22 0x23 0x23 0x24 0x24 0x25 0x25 0x26 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6a 0x6b 0x6c 0x6d 0x6e 0x6f 0x70 0x71 0x72 0x73 0x74 0x75 0x76 0x77 0x78 0x79 0x7a 0x7b 0x7c 0x7d 0x7e 0x7f 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f 0x90 0x91 0x92 0x93 0x94 0x95 0x96 0x97 0x98 0x99 0x9a 0x9b 0x9c 0x9d 0x9e 0x9f 0xa0 0xa1 0xa2 0xa3 0xa4 0xa5 0xa6 0xa7 0xa8 0xa9 0xaa 0xab 0xac 0xad 0xae 0xaf 0xb0 0xb1 0xb2 0xb3 0xb4 0xb5 0xb6 0xb7 0xb8 0xb9 0xba 0xbb 0xbc 0xbd 0xbe 0xbf 0xc0 0xc1 0xc2 0xc3 0xc4 0xc5 0xc6 0xc7 0xc8 0xc9 0xca 0xcb 0xcc 0xcd 0xce 0xcf 0xd0 0xd1 0xd2 0xd3 0xd4 0xd5 0xd6 0xd7 0xd8 0xd9 0xda 0xdb 0xdc 0xdd 0xde 0xdf 0xe0 0xe1 0xe2 0xe3 0xe4 0xe5 0xe6 0xe7 0xe8 0xe9 0xea 0xeb 0xec 0xed 0xee 0xef 0xf0 0xf1 0xf2 0xf3 0xf4 0xf5 0xf6 0xf7 0xf8 0xf9 0xfa 0xfb 0xfc 0xfd 0xfe 0xff>;
		compatible = "pwm-backlight";
		pwms = <0x154 0x00 0x61a8 0x00>;
		phandle = <0xa5>;
		status = "okay";
		default-brightness-level = <0xc8>;
	};

	sram@fdcc0000 {
		compatible = "mmio-sram";
		#size-cells = <0x01>;
		reg = <0x00 0xfdcc0000 0x00 0xb000>;
		ranges = <0x00 0x00 0xfdcc0000 0xb000>;
		#address-cells = <0x01>;

		rkvdec-sram@0 {
			phandle = <0x7c>;
			reg = <0x00 0xb000>;
		};
	};

	rkvdec-opp-table {
		nvmem-cell-names = "leakage\0pvtm";
		nvmem-cells = <0x7d 0x07>;
		compatible = "operating-points-v2";
		phandle = <0x7a>;
		rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x186a0 0x01>;
		rockchip,leakage-voltage-sel = <0x01 0x50 0x00 0x51 0xfe 0x01>;
		rockchip,pvtm-ch = <0x00 0x05>;

		opp-297000000 {
			opp-microvolt-L0 = <0xdbba0>;
			opp-hz = <0x00 0x11b3dc40>;
			opp-microvolt-L1 = <0xd59f8>;
			opp-microvolt = <0xdbba0>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xdbba0>;
		};
	};

	qos@fe148100 {
		compatible = "rockchip,rk3568-qos\0syscon";
		phandle = <0x52>;
		reg = <0x00 0xfe148100 0x00 0x20>;
	};

	pwm@fdd70020 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
		clock-names = "pwm\0pclk";
		pinctrl-0 = <0x4c>;
		clocks = <0x3a 0x0d 0x3a 0x30>;
		interrupts = <0x00 0x52 0x04>;
		reg = <0x00 0xfdd70020 0x00 0x10>;
		pinctrl-names = "active";
		#pwm-cells = <0x03>;
		status = "disabled";
	};

	qos@fe128000 {
		compatible = "rockchip,rk3568-qos\0syscon";
		phandle = <0x4f>;
		reg = <0x00 0xfe128000 0x00 0x20>;
	};

	iommu@fdf80800 {
		compatible = "rockchip,iommu-v2";
		power-domains = <0x26 0x0d>;
		#iommu-cells = <0x00>;
		interrupt-names = "rkvdec_mmu";
		clock-names = "aclk\0iface";
		clocks = <0x24 0x108 0x24 0x109>;
		interrupts = <0x00 0x5c 0x04>;
		phandle = <0x7b>;
		reg = <0x00 0xfdf80800 0x00 0x40 0x00 0xfdf80840 0x00 0x40>;
		status = "okay";
	};

	iommu@fdfe0800 {
		compatible = "rockchip,iommu-v2";
		power-domains = <0x26 0x08>;
		#iommu-cells = <0x00>;
		interrupt-names = "cif_mmu";
		clock-names = "aclk\0iface";
		clocks = <0x24 0xce 0x24 0xcf>;
		interrupts = <0x00 0x92 0x04>;
		phandle = <0x7e>;
		reg = <0x00 0xfdfe0800 0x00 0x100>;
		rockchip,disable-mmu-reset;
		status = "disabled";
	};

	usb@fd840000 {
		compatible = "generic-ohci";
		phys = <0x2d>;
		clock-names = "usbhost\0arbiter\0pclk\0utmi";
		clocks = <0x24 0xbd 0x24 0xbe 0x24 0xbc 0x2c>;
		interrupts = <0x00 0x83 0x04>;
		reg = <0x00 0xfd840000 0x00 0x40000>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	dummy-codec {
		compatible = "rockchip,dummy-codec";
		phandle = <0x157>;
		status = "disabled";
		#sound-dai-cells = <0x00>;
	};

	usbhost {
		compatible = "rockchip,rk3568-dwc3\0rockchip,rk3399-dwc3";
		#size-cells = <0x02>;
		clock-names = "ref_clk\0suspend_clk\0bus_clk\0pipe_clk";
		clocks = <0x24 0xa9 0x24 0xaa 0x24 0xa8 0x24 0x7f>;
		ranges;
		status = "okay";
		#address-cells = <0x02>;

		dwc3@fd000000 {
			resets = <0x24 0x95>;
			snps,dis_rxdet_inp3_quirk;
			compatible = "snps,dwc3";
			phy_type = "utmi_wide";
			snps,parkmode-disable-ss-quirk;
			phys = <0x2b 0x25 0x04>;
			power-domains = <0x26 0x0f>;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_enblslpm_quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			interrupts = <0x00 0xaa 0x04>;
			reg = <0x00 0xfd000000 0x00 0x400000>;
			phy-names = "usb2-phy\0usb3-phy";
			status = "okay";
			dr_mode = "host";
			snps,dis-del-phy-power-chg-quirk;
			reset-names = "usb3-host";
			snps,parkmode-disable-hs-quirk;
		};
	};

	chosen {
		linux,initrd-start = <0x00 0xa200000>;
		bootargs = "currentslot=0 bootslots=0 rw rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 ohos.boot.eng_mode=on root=PARTUUID=614e0000-0000 hardware=rk3568 default_boot_device=fe310000.sdhci ohos.required_mount.system=/dev/block/platform/fe310000.sdhci/by-name/system@/usr@ext4@ro,barrier=1@wait,required ohos.required_mount.vendor=/dev/block/platform/fe310000.sdhci/by-name/vendor@/vendor@ext4@ro,barrier=1@wait,required ohos.required_mount.misc=/dev/block/platform/fe310000.sdhci/by-name/misc@none@none@none@wait,required ohos.required_mount.bootctrl=/dev/block/platform/fe310000.sdhci/by-name/bootctrl@none@none@none@wait,required";
		linux,initrd-end = <0x00 0xa600000>;
	};

	syscon@fdc60000 {
		compatible = "rockchip,rk3568-grf\0syscon\0simple-mfd";
		phandle = <0x3b>;
		reg = <0x00 0xfdc60000 0x00 0x10000>;

		rgb {
			compatible = "rockchip,rk3568-rgb";
			pinctrl-0 = <0x36>;
			pinctrl-names = "default";
			status = "disabled";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@0 {
					#size-cells = <0x00>;
					reg = <0x00>;
					#address-cells = <0x01>;

					endpoint@2 {
						phandle = <0xa1>;
						remote-endpoint = <0x18>;
						reg = <0x02>;
						status = "disabled";
					};
				};
			};
		};

		lvds {
			compatible = "rockchip,rk3568-lvds";
			phys = <0x34>;
			phy-names = "phy";
			status = "disabled";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@0 {
					#size-cells = <0x00>;
					reg = <0x00>;
					#address-cells = <0x01>;

					endpoint@2 {
						phandle = <0xa0>;
						remote-endpoint = <0x35>;
						reg = <0x02>;
						status = "disabled";
					};

					endpoint@1 {
						phandle = <0x9e>;
						remote-endpoint = <0x17>;
						reg = <0x01>;
						status = "disabled";
					};
				};
			};
		};

		lvds1 {
			compatible = "rockchip,rk3568-lvds";
			phys = <0x37>;
			phy-names = "phy";
			status = "disabled";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@0 {
					#size-cells = <0x00>;
					reg = <0x00>;
					#address-cells = <0x01>;

					endpoint@0 {
						phandle = <0x9f>;
						remote-endpoint = <0x38>;
						reg = <0x00>;
					};

					endpoint@1 {
						phandle = <0xa2>;
						remote-endpoint = <0x39>;
						reg = <0x01>;
					};
				};
			};
		};

		io-domains {
			compatible = "rockchip,rk3568-io-voltage-domain";
			status = "disabled";
		};
	};

	iommu@fdff1a00 {
		compatible = "rockchip,iommu-v2";
		power-domains = <0x26 0x08>;
		#iommu-cells = <0x00>;
		interrupt-names = "isp_mmu";
		clock-names = "aclk\0iface";
		clocks = <0x24 0xd2 0x24 0xd3>;
		interrupts = <0x00 0x3b 0x04>;
		phandle = <0x82>;
		reg = <0x00 0xfdff1a00 0x00 0x100>;
		rockchip,disable-mmu-reset;
		status = "okay";
	};

	hdmi@fe0a0000 {
		avdd-1v8-supply = <0xb5>;
		compatible = "rockchip,rk3568-dw-hdmi";
		rockchip,grf = <0x3b>;
		power-domains = <0x26 0x09>;
		clock-names = "iahb\0isfr\0cec\0ref\0hclk";
		pinctrl-0 = <0xb1 0xb2 0xb3>;
		clocks = <0x24 0xe6 0x24 0xe7 0x24 0x193 0x3a 0x02 0x24 0xde>;
		interrupts = <0x00 0x2d 0x04>;
		phandle = <0x1c>;
		reg = <0x00 0xfe0a0000 0x00 0x20000>;
		pinctrl-names = "default";
		rockchip,phy-table = <0x58834d4 0x8009 0x00 0x270 0x9d5b340 0x800b 0x00 0x26d 0xb1069a8 0x800b 0x00 0x1ed 0x11b3dc40 0x800b 0x00 0x1ad 0x2367b880 0x8029 0x00 0x88 0x00 0x00 0x00 0x00>;
		reg-io-width = <0x04>;
		status = "okay";
		#sound-dai-cells = <0x00>;
		avdd-0v9-supply = <0xb4>;

		ports {
			#size-cells = <0x00>;
			#address-cells = <0x01>;

			port@0 {
				#size-cells = <0x00>;
				reg = <0x00>;
				#address-cells = <0x01>;

				endpoint@0 {
					phandle = <0x99>;
					remote-endpoint = <0x16>;
					reg = <0x00>;
					status = "okay";
				};

				endpoint@1 {
					phandle = <0x9d>;
					remote-endpoint = <0xb6>;
					reg = <0x01>;
					status = "disabled";
				};
			};
		};
	};

	pmu {
		interrupt-affinity = <0x1f 0x20 0x21 0x22>;
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0xe4 0x04 0x00 0xe5 0x04 0x00 0xe6 0x04 0x00 0xe7 0x04>;
	};

	cpuinfo {
		nvmem-cell-names = "id\0cpu-version\0cpu-code";
		nvmem-cells = <0x0c 0x0d 0x0e>;
		compatible = "rockchip,cpuinfo";
	};

	vad-sound {
		rockchip,card-name = "rockchip,rk3568-vad";
		compatible = "rockchip,multicodecs-card";
		rockchip,codec = <0x158 0x15b>;
		rockchip,cpu = <0xe1>;
		status = "disabled";
	};

	rkisp-vir0 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <0x83>;
		status = "okay";

		port {
			#size-cells = <0x00>;
			#address-cells = <0x01>;

			endpoint@0 {
				phandle = <0x12f>;
				remote-endpoint = <0x84>;
				reg = <0x00>;
			};
		};
	};

	pwm@fe700030 {

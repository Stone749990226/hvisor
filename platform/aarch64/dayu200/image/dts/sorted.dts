			reg = <0x20>;
			#clock-cells = <0x01>;
			pinctrl-3 = <0x43 0x45>;
			pinctrl-names = "default\0pmic-sleep\0pmic-power-off\0pmic-reset";
			pmic-reset-func = <0x00>;
			vcc3-supply = <0x46>;
			vcc8-supply = <0x46>;
			vcc2-supply = <0x46>;
			vcc5-supply = <0x46>;
			vcc7-supply = <0x46>;

			pwrkey {
				status = "okay";
			};

			codec {
				compatible = "rockchip,rk809-codec\0rockchip,rk817-codec";
				spk-volume = <0x03>;
				hp-volume = <0x14>;
				clock-names = "mclk";
				pinctrl-0 = <0x47>;
				clocks = <0x24 0x1a3>;
				phandle = <0x158>;
				assigned-clocks = <0x24 0x1a3 0x24 0x1a6>;
				assigned-clock-parents = <0x24 0x48 0x24 0x48>;
				assigned-clock-rates = <0xbb8000>;
				pinctrl-names = "default";
				mic-in-differential;
				status = "okay";
				#sound-dai-cells = <0x00>;
			};

			regulators {

				DCDC_REG4 {
					regulator-initial-mode = <0x02>;
					regulator-init-microvolt = <0xdbba0>;
					regulator-always-on;
					regulator-max-microvolt = <0x149970>;
					phandle = <0x6b>;
					regulator-boot-on;
					regulator-ramp-delay = <0x1771>;
					regulator-name = "vdd_npu";
					regulator-min-microvolt = <0x7a120>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG5 {
					regulator-always-on;
					regulator-max-microvolt = <0x325aa0>;
					phandle = <0x31>;
					regulator-boot-on;
					regulator-name = "vccio_sd";
					regulator-min-microvolt = <0x1b7740>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG2 {
					regulator-always-on;
					regulator-max-microvolt = <0xdbba0>;
					regulator-boot-on;
					regulator-name = "vdda_0v9";
					regulator-min-microvolt = <0xdbba0>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				SWITCH_REG2 {
					regulator-always-on;
					phandle = <0xc4>;
					regulator-boot-on;
					regulator-name = "vcc3v3_sd";

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				SWITCH_REG1 {
					regulator-always-on;
					phandle = <0x33>;
					regulator-boot-on;
					regulator-name = "vcc_3v3";

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG8 {
					regulator-always-on;
